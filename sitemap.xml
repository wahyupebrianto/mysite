---
sitemap: false
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages -%}
  {%- if p.sitemap == false -%}{%- continue -%}{%- endif -%}
  {%- if p.name contains ".md" or p.name contains ".html" -%}
    {%- include hidden-flag.html item=p -%}
    {%- unless hidden %}
  <url>
    <loc>{{ p.url | absolute_url | xml_escape }}</loc>
  </url>
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}
{%- for p in site.posts -%}
  {%- include hidden-flag.html item=p -%}
  {%- unless hidden %}
  <url>
    <loc>{{ p.url | absolute_url | xml_escape }}</loc>
    <lastmod>{{ p.last_modified_at | default: p.date | date_to_xmlschema }}</lastmod>
  </url>
  {%- endunless -%}
{%- endfor %}
</urlset>
